# fixplan settings for the container. Every setting in ~/.fixplan.yml works as FIXPLAN_<KEY>.
FIXPLAN_MODEL=qwen2.5-coder:14b
FIXPLAN_LANGUAGE=en
FIXPLAN_NUM_CTX=16384
# FIXPLAN_WORKERS=2          # with OLLAMA_NUM_PARALLEL=2 on the Ollama side
# FIXPLAN_MAX_UPLOAD_MB=50
# FIXPLAN_HOUSE_RULES=We run OpenShift: containers get a random UID and never run as root.
# OLLAMA_HOST=http://gpu-box:11434   # overrides the Quadlet's Environment= line
